# API Keys — copy this file to .env and fill in your values.
# The .env file is gitignored and must NEVER be committed.

# Required only if using API-based embedding providers (google-genai, cohere).
# Not needed for sentence_transformers models (e.g. bge-m3, multilingual-e5).
OPENAI_API_KEY=your-openai-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
HUGGINGFACEHUB_API_TOKEN=your-huggingface-token-here

# Qdrant vector database endpoint.
# Default: local Qdrant instance started with Docker.
QDRANT_URL=http://localhost:6333

# Optional overrides (also configurable in distributed_config.yaml).
TOP_K=5
BATCH_SIZE=32
